# ========================================================
# OSRA EDUCATION INSTITUTE - BACKEND ENVIRONMENT VARIABLES
# ========================================================

# SERVER CONFIG
PORT=5000
NODE_ENV=production

# DATABASE (Dedicated MongoDB Atlas database for Osra Institute)
# Replace <username>, <password>, and cluster details with your Atlas database credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/osra_institute_db?retryWrites=true&w=majority

# AUTHENTICATION (JWT)
JWT_SECRET=super_secret_jwt_key_osra_institute_2026
JWT_EXPIRES_IN=7d

# FRONTEND URL (CORS allowed origins)
CLIENT_URL=http://localhost:3000

# OPTIONAL PAYMENT GATEWAY (PayHere / Stripe)
PAYMENT_SECRET=
PAYMENT_PUBLIC_KEY=

# OPTIONAL SMS GATEWAY (e.g., Notify.lk, Mobitel, or Hutch Android Gateway)
SMS_API_KEY=
SMS_SENDER_ID=OSRA
